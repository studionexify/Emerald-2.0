// Cloudflare Workers static-assets deploy for Emerald. The only server code here is the /nexder-dl download Worker; Supabase does the backend.
{
  "name": "emerald-2-0",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // PR branches build a Worker Preview (Workers Builds "Preview command": npx wrangler preview).
  "preview_urls": true,
  "previews": {},
  // Only /nexder-dl runs code (see src/worker.ts); everything else stays free static assets.
  // Secret to add (dashboard → Workers → emerald-2-0 → Settings → Variables and Secrets, or `npx wrangler secret put NEXDER_TICKET_KEY`).
  "main": "./src/worker.ts",
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/nexder-dl"] }
}
