// Cloudflare Workers static-assets deploy for Emerald (no server code; Supabase does the backend).
{
  "name": "emerald-2-0",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // PR branches build a Worker Preview (Workers Builds "Preview command": npx wrangler preview).
  "preview_urls": true,
  "previews": {},
  "assets": { "directory": "./dist", "not_found_handling": "single-page-application" }
}
